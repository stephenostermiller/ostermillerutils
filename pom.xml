<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.ostermiller</groupId>
	<artifactId>ostermillerutils</artifactId>
	<inceptionYear>2001</inceptionYear>
	<version>${revision}</version>
	<name>Ostermiller Java Utilities</name>
	<url>https://ostermiller.org/utils/</url>
	<packaging>jar</packaging>
	<description>
		Open source (GPL) Java utilities maintained by Stephen Ostermiller with
		help from many contributors.
	</description>
	<licenses>
		<license>
			<name>GNU General Public License, version 2</name>
			<url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<connection>scm:git:ssh://steveo@source.ostermiller.org/git/ostermillerutils.git</connection>
	</scm>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<repositories>
		<repository>
			<id>central</id>
			<name>Maven Repository Switchboard</name>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
		<repository>
			<id>com.anasoft.os.repository.releases</id>
			<name>ANASOFT OpenSource releases</name>
			<url>https://anasoft-os-repo.googlecode.com/svn/repository/releases</url>
		</repository>
	</repositories>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.0.2</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<executions>
					<execution>
						<id>utilsjar</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
					<execution>
						<id>randpassjar</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<phase>site</phase>
						<configuration>
							<finalName>randpass</finalName>
							<outputDirectory>${project.build.directory}/site</outputDirectory>
							<includes>
								<include>**/RandPass*</include>
								<include>**/LICENSE*</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>2.1.2</version>
				<executions>
				<execution>
				<goals>
					<goal>jar</goal>
				</goals>
				</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>de.jflex</groupId>
				<artifactId>maven-jflex-plugin</artifactId>
				<version>1.4.3</version>
				<executions>
					<execution>
						<id>jflex with csv skeleton</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<skeleton>src/main/jflexcsv/com/Ostermiller/util/csv.jflex.skel</skeleton>
							<lexDefinitions>
								<lexDefinition>src/main/jflexcsv</lexDefinition>
							</lexDefinitions>
						</configuration>
					</execution>
					<execution>
						<id>jflex</id>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
            <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.12.1</version>
				<configuration>
					<siteDirectory>${project.build.directory}/site-template</siteDirectory>
					<outputFormat>xhtml5</outputFormat>
					<attributes>
						<disabledModules>poweredBy</disabledModules>
					</attributes>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.apache.maven.doxia</groupId>
						<artifactId>doxia-sink-api</artifactId>
						<version>1.12.0</version>
					</dependency>
					<dependency>
						<groupId>org.apache.maven.doxia</groupId>
						<artifactId>doxia-core</artifactId>
						<version>1.12.0</version>
					</dependency>
				</dependencies>
            </plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<filtering>false</filtering>
				</configuration>
				<executions>
					<execution>
						<id>srcSiteToGenerated</id>
						<phase>pre-site</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/site-template</outputDirectory>
							<resources>
								<resource>
									<directory>src/site</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>archivesToSite</id>
						<phase>site</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/site</outputDirectory>
							<resources>
								<resource>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>*.zip</include>
										<include>*.tar.gz</include>
										<include>*.tar.bz2</include>
										<!--<include>*.deb</include>-->
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>javadocToSite</id>
						<phase>site</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/site/doc</outputDirectory>
							<resources>
								<resource>
									<directory>${project.build.directory}/javadoc</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>releasesToSite</id>
						<phase>site</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/site</outputDirectory>
							<overwrite>true</overwrite>
							<resources>
								<resource>
									<directory>${basedir}/releases</directory>
									<includes>
										<include>**/*</include>
									</includes>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>licenseToClasses</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/classes/com/Ostermiller/util</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}</directory>
									<includes>
										<include>LICENSE*</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>2.7</version>
				<configuration>
					<show>public</show>
					<nohelp>true</nohelp>
					<bottom><![CDATA[
						<p>Copyright &#169; {inceptionYear}-{currentYear} by <a href="https://ostermiller.org/contact.pl?regarding=Java+Utilities">Stephen Ostermiller</a></p>
					]]></bottom>
					<header><![CDATA[
						<h1><a target=\"_top\" href="https://ostermiller.org/utils/">com.Ostermiller.util</a> Java Utilities</h1>
					]]></header>
				</configuration>
				<executions>
					<execution>
						<id>jar</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<phase>package</phase>
					</execution>
					<execution>
						<id>javadoc</id>
						<goals>
							<goal>javadoc</goal>
						</goals>
						<configuration>
							<reportOutputDirectory>${project.build.directory}</reportOutputDirectory>
							<destDir>javadoc</destDir>
						</configuration>
					</execution>
					<execution>
						<id>doc</id>
						<goals>
							<goal>javadoc</goal>
						</goals>
						<phase>site</phase>
						<configuration>
							<reportOutputDirectory>${project.build.directory}/site</reportOutputDirectory>
							<destDir>doc</destDir>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.2-beta-5</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>project</descriptorRef>
						<descriptorRef>bin</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<id>generate-site-files</id>
						<phase>pre-site</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>perl</executable>
							<arguments>
								<argument>src/build/script/site_file_lists.pl</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>copy-utils-jar-to-site</id>
						<phase>site</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>sh</executable>
							<arguments>
								<argument>-c</argument>
								<argument>cp ${project.build.directory}/${project.artifactId}-${project.version}.jar ${project.build.directory}/site/utils.jar</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>post-process-html</id>
						<phase>post-site</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>perl</executable>
							<arguments>
								<argument>src/build/script/post_process_html.pl</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<version>2.0.1</version>
				<reportSets>
					<reportSet>
						<reports>
						</reports>
					</reportSet>
				</reportSets>
			</plugin>
		</plugins>
	</reporting>
	<developers>
		<developer>
			<name>Stephen Ostermiller</name>
		</developer>
	</developers>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.reporting.sourceEncoding>UTF-8</project.reporting.sourceEncoding>
		<revision>DEV</revision>
	</properties>
</project>
